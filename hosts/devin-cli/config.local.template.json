{
  "mcpServers": {
    "alfred-email": {
      "command": "python",
      "args": ["${env:ALFRED_HOME}/scripts/adapters/mcp-email-server.py"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {"CONTEXT7_API_KEY": "${env:CONTEXT7_API_KEY}"}
    }
  }
}
